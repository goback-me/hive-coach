POSTGRES_PASSWORD=change-this-password
DATABASE_URL=postgresql://coach:change-this-password@coach_os_postgres:5432/coach_os
NEXTAUTH_SECRET=
NEXTAUTH_URL=

# Clerk — from your Clerk dashboard → your app → API Keys.
# NEXT_PUBLIC_* is safe to expose to the browser (required for client-side auth UI).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret key — NEVER expose this to the browser, NEVER prefix with NEXT_PUBLIC_.
# Used server-side (lib/clerk-admin.ts, middleware.ts) for session checks and to
# create/delete client & coach logins.
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Routing — matches app/login/[[...login]]/page.tsx in this project.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard

# Swarm (first-party tracking) — server-to-server only, NEVER sent to the
# browser. Must match DASHBOARD_USER/DASHBOARD_PASS set on the Swarm
# instance's own .env. Used only to (1) verify a client's install and
# (2) mint short-lived scoped embed tokens for the Tracking tab's iframe —
# the domain these credentials unlock never appears in any URL a browser sees.
SWARM_URL=https://data.tryrevvy.com.au
SWARM_DASHBOARD_USER=admin
SWARM_DASHBOARD_PASS=

# Google Sheets (lead tracking, read-only). OAuth client from Google Cloud
# Console; the redirect URI must be registered on it exactly as written here.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://thebakery.academy/api/google/callback
# 64 hex chars — encrypts the stored Google tokens. Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# POST /api/cron/sync with header `x-cron-secret: <this>` re-syncs every client's sheet.
CRON_SECRET=

# Meta (Facebook) Ads — "Connect with Facebook" on each client's Ads tab.
# developers.facebook.com → your app → Facebook Login: add META_REDIRECT_URI as a Valid OAuth Redirect URI.
# The ads_read permission needs App Review before people outside the app's roles can connect.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://thebakery.academy/api/meta/callback
# Business-type apps: Facebook Login for Business → Configurations → create one
# (User access token, permission ads_read) and paste its Configuration ID here.
META_CONFIG_ID=

# Homepage enquiry form → email to hello@hivesocial.com.au (Resend, same key/sender as Hive OS)
RESEND_API_KEY=
EMAIL_FROM=
