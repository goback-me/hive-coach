generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  COACH
  CLIENT
}

enum SessionStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ClientStatus {
  ACTIVE
  ONBOARDING
  CHURNED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskSource {
  MANUAL
  CLICKUP
}

model Task {
  id            String     @id @default(cuid())
  title         String
  status        TaskStatus @default(NOT_STARTED)
  assignee      String?
  clientId      String?
  client        Client?    @relation(fields: [clientId], references: [id])
  dueDate       DateTime?
  source        TaskSource @default(MANUAL)
  clickupTaskId String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status, dueDate])
  @@index([clientId])
}

// ── Onboarding template — global checklist, applied to every client ────
model OnboardingStepTemplate {
  id          String   @id @default(cuid())
  title       String
  description String?
  icon        String   @default("task_alt")
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  completions ClientOnboardingStep[]
}

model ClientOnboardingStep {
  id           String                  @id @default(cuid())
  clientId     String
  client       Client                  @relation(fields: [clientId], references: [id])
  templateId   String
  template     OnboardingStepTemplate  @relation(fields: [templateId], references: [id])
  completedAt  DateTime?

  @@unique([clientId, templateId])
}

// ── Playbooks / course modules ──────────────────────────────────────────
model Module {
  id      String   @id @default(cuid())
  title   String
  order   Int      @default(0)
  lessons Lesson[]
}

model Lesson {
  id          String   @id @default(cuid())
  moduleId    String
  module      Module   @relation(fields: [moduleId], references: [id])
  title       String
  videoUrl    String?
  content     String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  completions ClientLessonProgress[]
}

model ClientLessonProgress {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id])
  completedAt DateTime?

  @@unique([clientId, lessonId])
}

// ── Ads — schema ready for Meta Ads API / server-tracker sync ──────────
model AdCampaign {
  id             String   @id @default(cuid())
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id])
  name           String
  status         String   @default("active")
  spend          Decimal  @default(0) @db.Decimal(10, 2)
  impressions    Int      @default(0)
  profileVisits  Int      @default(0)
  engagement     Int      @default(0)
  saves          Int      @default(0)
  metaCampaignId String?
  syncedAt       DateTime?
  createdAt      DateTime @default(now())

  @@index([clientId])
}

// ── Awards — auto-granted on revenue milestones or course completion ───
model AwardTier {
  id                 String   @id @default(cuid())
  name               String
  subtitle           String?
  thresholdRevenue   Decimal? @db.Decimal(10, 2)
  requiredModuleId   String?
  order              Int      @default(0)
  clientAwards       ClientAward[]
}

model ClientAward {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  awardTierId String
  awardTier   AwardTier @relation(fields: [awardTierId], references: [id])
  earnedAt    DateTime  @default(now())

  @@unique([clientId, awardTierId])
}

// ── Integration settings — single row, ClickUp / CRM connection info ───
model IntegrationSettings {
  id             String   @id @default("singleton")
  clickupApiKey  String?
  clickupTeamId  String?
  crmType        String?  // "ghl" | "spreadsheet"
  crmApiKeyOrUrl String?
  updatedAt      DateTime @updatedAt
}

// Auth lives in Clerk — this table is the app-side profile that maps a
// Clerk account to a role and (for clients) the one Client record they're
// allowed to see.
model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique // maps to Clerk's user.id
  email     String   @unique
  role      UserRole
  name      String
  clientId  String? // required for role=CLIENT, null for role=COACH (coach/admin sees everything)
  client    Client?  @relation(fields: [clientId], references: [id])
  createdAt DateTime @default(now())

  @@index([clientId])
}

enum ReferralStage {
  INTRODUCED
  REACHED_OUT
  IN_CONVERSATION
  CALL_BOOKED
  CALL_DONE
  WON
}

model ReferralLink {
  id        String     @id @default(cuid())
  code      String     @unique
  label     String
  createdAt DateTime   @default(now())
  referrals Referral[]
}

model Referral {
  id             String        @id @default(cuid())
  name           String
  source         String?
  note           String?
  stage          ReferralStage @default(INTRODUCED)
  referralLinkId String?
  referralLink   ReferralLink? @relation(fields: [referralLinkId], references: [id])
  createdAt      DateTime      @default(now())

  @@index([stage])
}

model Program {
  id            String   @id @default(cuid())
  name          String
  description   String?
  durationWeeks Int?
  clients       Client[]
  createdAt     DateTime @default(now())
}

model Client {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  email         String?
  isActive      Boolean      @default(true)
  status        ClientStatus @default(ONBOARDING)
  goals         String?
  description   String?
  programId     String?
  program       Program?  @relation(fields: [programId], references: [id])
  joinedAt      DateTime  @default(now())

  users         User[]
  sessions      Session[]
  progressNotes ProgressNote[]
  payments      Payment[]
  needsActionItems NeedsActionItem[]
  tasks         Task[]
  onboardingSteps ClientOnboardingStep[]
  lessonProgress ClientLessonProgress[]
  adCampaigns   AdCampaign[]
  awards        ClientAward[]
  gameplanFigmaLink String?

  // Swarm/TrafficLedger tracking integration — Coach OS never shares a
  // database with Swarm; stats are fetched live over HTTP, keyed by this
  // client's website hostname (that's how Swarm's own multi-tenancy works —
  // no client id needed, the tracker infers "site" from the tracked page URL).
  trackingWebsiteUrl String?
  trackingVerifiedAt DateTime? // last time we confirmed the pixel script is actually live on their site
}

model Session {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id])
  scheduledAt DateTime
  durationMin Int           @default(45)
  status      SessionStatus @default(SCHEDULED)
  notes       String?
  createdAt   DateTime      @default(now())

  @@index([clientId, scheduledAt])
}

model ProgressNote {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id])
  note      String
  createdBy String
  createdAt DateTime @default(now())

  @@index([clientId, createdAt])
}

model Payment {
  id         String        @id @default(cuid())
  clientId   String
  client     Client        @relation(fields: [clientId], references: [id])
  label      String
  amountDue  Decimal       @db.Decimal(10, 2)
  dueDate    DateTime
  status     PaymentStatus @default(PENDING)
  paidDate   DateTime?
  createdAt  DateTime      @default(now())

  @@index([status, dueDate])
}

// Cached rules-engine output — overdue payments, upcoming/missed sessions,
// no-contact — same pattern as Hive OS's Needs Action feed.
model NeedsActionItem {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id])
  type        String
  severity    String
  title       String
  description String
  computedAt  DateTime @default(now())

  @@index([computedAt])
}
